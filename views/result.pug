// Result page

doctype html
html

    head
        title Travel Planner Pro Results
        meta(name="viewport", content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")


    body

        .page-container

        // Main Heading

        // Handled API failures
        
        if weather && country

            h1= weather.city + ", " + country.name

        else

            h1 Travel information unavailable


        // Country Information

        if country

            .info-card

                h2= country.name

                img(src=country.flag width="150" alt="Country Flag")


                p
                    strong Region:
                    |  #{country.region}


                p
                    strong Population:
                    |  #{country.population.toLocaleString()}


                p
                    strong Currency:
                    |  #{country.currency}


                p
                    strong Languages:
                    |  #{country.languages}


        else

            .info-card

                p Country information unavailable

        hr

        // Weather Forecast

        h2 3 Day Weather Forecast


        .weather-container


            each day in weather.forecast


                .weather-card


                    h3= day.date


                    img(
                        src=day.day.condition.icon
                        alt="Weather Icon"
                    )


                    p
                        strong Condition:
                        |  #{day.day.condition.text}



                    p
                        strong Maximum Temperature:
                        |  #{day.day.maxtemp_c} °C



                    p
                        strong Minimum Temperature:
                        |  #{day.day.mintemp_c} °C



                    p
                        strong Average Humidity:
                        |  #{day.day.avghumidity} %



                    p
                        strong Chance of Rain:
                        |  #{day.day.daily_chance_of_rain} %



                    p
                        strong UV Index:
                        |  #{day.day.uv}



                    p
                        strong Maximum Wind:
                        |  #{day.day.maxwind_kph} km/h


        hr

        // Events Section

        h2 Upcoming Events


        if events.length === 0

            .event-card

                p No upcoming events found.

        else

            .events-container

                each event in events

                    .event-card

                        h3= event.title


                        p
                            strong Date:
                            |  #{event.date}



                        p
                            strong Time:
                            |  #{event.time}



                        p
                            strong Type:
                            |  #{event.type}



                        p
                            strong Venue:
                            |  #{event.venue}


                        if event.indoor

                            p
                                strong Location:
                                |  Indoor Event


                        else

                            p
                                strong Location:
                                |  Outdoor Event


                        a(
                            href=event.url
                            target="_blank"
                        )
                            | Buy Tickets


        a.back-button(href="/") ← Search Another Destination